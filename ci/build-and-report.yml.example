# Template; copy to .github/workflows/ once a runner can provide the executable.
name: Build and report progress

on:
  push:
    branches: [main]
  workflow_dispatch: {}

jobs:
  build:
    # Option A: a self-hosted Windows runner that keeps the retail executable
    # in a private folder outside the repository.
    runs-on: [self-hosted, windows]
    defaults:
      run:
        shell: pwsh
    steps:
      - uses: actions/checkout@v4

      - name: Provide the retail executable (never committed)
        run: |
          New-Item -ItemType Directory -Force orig | Out-Null
          Copy-Item "$env:DECOMP_REFS\SCUS_972.64" orig\SCUS_972.64 -Force
        # DECOMP_REFS is an environment variable configured on the runner.
        # Option B (GitHub-hosted ubuntu-latest): download/decrypt the file from
        # a repository secret here instead, and run the compiler through wibo.

      - name: Install Python packages and tools
        run: |
          python -m pip install -r requirements.txt
          python tools/setup_tools.py

      - name: Configure and build (fails unless byte-identical)
        run: |
          python configure.py
          ninja

      - name: Generate progress report
        run: ninja report

      - name: Upload report artifact
        uses: actions/upload-artifact@v4
        with:
          name: SCUS_972.64_report
          path: build/report.json
